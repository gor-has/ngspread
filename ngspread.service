[Unit]
Description=NGspread messaging daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
RuntimeDirectory=spread
RuntimeDirectoryMode=0755
ExecStart=/usr/local/sbin/spread -c /etc/ngspread/spread.conf
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
