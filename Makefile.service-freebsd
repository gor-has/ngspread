# Install the FreeBSD rc.d service for ngspread.
#
# Source service file:
#
#   service/service.freebsd
#
# Installed service file:
#
#   /usr/local/etc/rc.d/ngspread
#
# The daemon and spuser themselves are installed by Makefile.prog.

PREFIX ?= /usr/local

INSTALL ?= install

SERVICE_USER ?= spread
SERVICE_GROUP ?= spread

CONFIG_DIR ?= $(PREFIX)/etc/ngspread
CONFIG_FILE ?= $(CONFIG_DIR)/spread.conf
CONFIG_SRC ?= spread.conf.example

RUN_DIR ?= /var/run/spread

SERVICE_SRC ?= service/service.freebsd
SERVICE_DST ?= $(PREFIX)/etc/rc.d/ngspread

.PHONY: install install-user install-dirs install-config install-service \
        enable restart uninstall

install: install-user install-dirs install-config install-service enable

install-user:
	@if ! pw groupshow $(SERVICE_GROUP) >/dev/null 2>&1; then \
		echo "Creating group $(SERVICE_GROUP)"; \
		pw groupadd $(SERVICE_GROUP); \
	fi
	@if ! pw usershow $(SERVICE_USER) >/dev/null 2>&1; then \
		echo "Creating user $(SERVICE_USER)"; \
		pw useradd $(SERVICE_USER) \
		    -g $(SERVICE_GROUP) \
		    -d /nonexistent \
		    -s /usr/sbin/nologin \
		    -c "ngspread daemon"; \
	fi

install-dirs:
	$(INSTALL) -d -m 0755 $(CONFIG_DIR)
	$(INSTALL) -d -m 0755 -o $(SERVICE_USER) -g $(SERVICE_GROUP) $(RUN_DIR)

install-config:
	@if [ ! -f "$(CONFIG_FILE)" ]; then \
		echo "Installing $(CONFIG_FILE)"; \
		$(INSTALL) -m 0644 $(CONFIG_SRC) $(CONFIG_FILE); \
	else \
		echo "Keeping existing $(CONFIG_FILE)"; \
	fi

install-service:
	$(INSTALL) -d -m 0755 $(PREFIX)/etc/rc.d
	$(INSTALL) -m 0555 $(SERVICE_SRC) $(SERVICE_DST)

enable:
	sysrc ngspread_enable="YES"

restart:
	service ngspread restart

uninstall:
	-service ngspread stop
	-sysrc -x ngspread_enable
	rm -f $(SERVICE_DST)
