# Makefile.linux
#
# Linux/systemd installation for NGspread.
#

PREFIX          ?= /usr/local
BINDIR          ?= $(PREFIX)/bin
SBINDIR         ?= $(PREFIX)/sbin
SYSCONFDIR      ?= /etc/ngspread
SYSTEMD_DIR     ?= /etc/systemd/system

DAEMON          = spread
DAEMON_SRC      = ./spread
DAEMON_DST      = $(SBINDIR)/$(DAEMON)

SPUSER          = spuser
SPUSER_SRC      = ./spuser
SPUSER_DST      = $(BINDIR)/$(SPUSER)

CONF_SRC        = ./spread.conf
CONF_DST        = $(SYSCONFDIR)/spread.conf

SERVICE         = ngspread.service
SERVICE_DST     = $(SYSTEMD_DIR)/$(SERVICE)

SPREAD_USER     = spread
SPREAD_GROUP    = spread
RUNTIME_DIR     = /var/run/spread

.PHONY: all install install-user install-runtime install-bin install-spuser \
        install-conf install-service enable start stop restart status logs uninstall

all:
	@echo "NGspread Linux installation targets:"
	@echo "  make -f Makefile.linux install"
	@echo "  make -f Makefile.linux start"
	@echo "  make -f Makefile.linux status"
	@echo "  make -f Makefile.linux logs"

install: install-user install-runtime install-bin install-spuser install-conf install-service
	systemctl enable $(SERVICE)
	@echo
	@echo "NGspread installed and enabled."
	@echo "Daemon:        $(DAEMON_DST)"
	@echo "Client:        $(SPUSER_DST)"
	@echo "Configuration: $(CONF_DST)"
	@echo
	@echo "Start with:"
	@echo "  systemctl start $(SERVICE)"

install-user:
	@if ! getent group $(SPREAD_GROUP) >/dev/null; then \
	    echo "Creating system group $(SPREAD_GROUP)"; \
	    groupadd --system $(SPREAD_GROUP); \
	fi
	@if ! getent passwd $(SPREAD_USER) >/dev/null; then \
	    echo "Creating system user $(SPREAD_USER)"; \
	    useradd --system \
	        --gid $(SPREAD_GROUP) \
	        --no-create-home \
	        --shell /usr/sbin/nologin \
	        $(SPREAD_USER); \
	fi

install-runtime:
	install -d -o root -g root -m 0755 $(RUNTIME_DIR)

install-bin:
	@test -x $(DAEMON_SRC) || \
	    { echo "ERROR: $(DAEMON_SRC) missing or not executable"; exit 1; }
	install -d -m 0755 $(SBINDIR)
	install -m 0755 $(DAEMON_SRC) $(DAEMON_DST)

install-spuser:
	@test -x $(SPUSER_SRC) || \
	    { echo "ERROR: $(SPUSER_SRC) missing or not executable"; exit 1; }
	install -d -m 0755 $(BINDIR)
	install -m 0755 $(SPUSER_SRC) $(SPUSER_DST)

install-conf:
	install -d -m 0755 $(SYSCONFDIR)
	@if test ! -f $(CONF_SRC); then \
	    echo "ERROR: $(CONF_SRC) not found"; \
	    exit 1; \
	fi
	@if test ! -f $(CONF_DST); then \
	    install -m 0644 $(CONF_SRC) $(CONF_DST); \
	else \
	    echo "$(CONF_DST) already exists -- not overwritten"; \
	fi

install-service:
	install -d -m 0755 $(SYSTEMD_DIR)
	install -m 0644 ngspread.service $(SERVICE_DST)
	systemctl daemon-reload

enable:
	systemctl enable $(SERVICE)

start:
	systemctl start $(SERVICE)

stop:
	systemctl stop $(SERVICE)

restart:
	systemctl restart $(SERVICE)

status:
	systemctl status $(SERVICE)

logs:
	journalctl -u $(SERVICE) -n 100 --no-pager

uninstall:
	-systemctl disable --now $(SERVICE)
	rm -f $(SERVICE_DST)
	systemctl daemon-reload
	@echo "The following have deliberately been left in place:"
	@echo "  $(DAEMON_DST)"
	@echo "  $(SPUSER_DST)"
	@echo "  $(CONF_DST)"
