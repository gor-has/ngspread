{
  "_note": "Prototype only. Placeholder for a future JSON configuration parser. The current daemon does not yet consume this format.",
  "daemon": {
    "name": "localhost",
    "runtime_dir": "/var/run/spread",
    "user": "spread",
    "group": "spread"
  },
  "segments": [
    {
      "address": "127.0.0.255",
      "port": 4803,
      "processes": [
        {
          "name": "localhost",
          "address": "127.0.0.1"
        }
      ]
    }
  ],
  "network": {
    "socket_port_reuse": "AUTO",
    "dangerous_monitor": false
  },
  "logging": {
    "debug_flags": [
      "PRINT",
      "EXIT"
    ],
    "event_log_file": "spread.log",
    "event_timestamp": "[%a %d %b %Y %H:%M:%S]"
  },
  "authentication": {
    "allowed_methods": [
      "NULL"
    ],
    "required_methods": [],
    "access_control_policy": "PERMIT"
  },
  "flow_control": {
    "_note": "Reserved for future JSON mapping of existing Spread flow-control settings."
  },
  "routing": {
    "_note": "Reserved for future JSON mapping of RouteMatrix/LinkCost configuration."
  }
}
